# ──────────────────────────────────────────────────────────────
# Sign0 Environment Template  (commit this, NOT .env)
# ──────────────────────────────────────────────────────────────

# ── Database ───────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://sign0:sign0pass@localhost:5432/sign0db
POSTGRES_USER=sign0
POSTGRES_PASSWORD=sign0pass
POSTGRES_DB=sign0db

# ── pgAdmin ────────────────────────────────────────────────────
PGADMIN_EMAIL=admin@sign0.ai
PGADMIN_PASSWORD=changeme

# ── Grafana ────────────────────────────────────────────────────
GRAFANA_PASSWORD=changeme

# ── Security ────────────────────────────────────────────────────
SIGN0_SECRET_KEY=REPLACE_WITH_32_HEX_CHARS

# ── Stripe ─────────────────────────────────────────────────────
STRIPE_API_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_PRO=price_...
STRIPE_PRICE_DEVELOPER=price_...

# ── Server ─────────────────────────────────────────────────────
ENVIRONMENT=production
DEBUG=false
HOST=0.0.0.0
PORT=8000
